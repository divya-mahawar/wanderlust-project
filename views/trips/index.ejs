<% layout("/layouts/boilerplate") %>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>🗺️ My Saved Trips</h2>
            <p class="text-muted">
                Your saved travel itineraries
            </p>
        </div>

        <a
            href="/listings"
            class="btn btn-dark"
        >
            Explore Listings
        </a>

    </div>


    <% if (trips.length === 0) { %>

        <div class="text-center py-5">

            <div style="font-size:60px;">
                🧳
            </div>

            <h4 class="mt-3">
                No saved trips yet
            </h4>

            <p class="text-muted">
                Create your first travel itinerary.
            </p>

            <a
                href="/listings"
                class="btn btn-dark"
            >
                Plan a Trip
            </a>

        </div>

    <% } else { %>


        <div class="row g-4">

            <% trips.forEach(trip => { %>

                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <% if (trip.listing?.image?.url) { %>

                            <img
                                src="<%= trip.listing.image.url %>"
                                class="card-img-top"
                                style="height:220px; object-fit:cover;"
                            >

                        <% } %>


                        <div class="card-body">

                            <h5 class="card-title">
                                <%= trip.listing?.title || "Saved Trip" %>
                            </h5>

                            <p class="text-muted">
                                📍 <%= trip.listing?.location || "Unknown location" %>
                            </p>

                            <p>
                                🗓️
                                <b><%= trip.days %></b>
                                days
                            </p>


                            <a
                                href="/trips/<%= trip._id %>"
                                class="btn btn-dark w-100"
                            >
                                View Trip
                            </a>


                            <form
                                action="/trips/<%= trip._id %>?_method=DELETE"
                                method="POST"
                                class="mt-2"
                            >

                                <button
                                    type="submit"
                                    class="btn btn-outline-danger w-100"
                                >
                                    🗑️ Delete Trip
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>