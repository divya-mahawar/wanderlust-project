  <% layout("/layouts/boilerplate") %>
  <%= success %>
  <style>
  #filters {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    padding: 1rem 2rem;
    margin-top: 1rem;
    width: 100%;
    overflow-x: auto;
    white-space: nowrap;
  }

  .filter {
    flex: 0 0 auto;
    width: 80px;
    text-align: center;
    opacity: 0.7;
    text-decoration: none;
    color: black;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter i {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }

  .filter p {
    font-size: 0.8rem;
    margin: 0;
  }

  .tax-toggle {
    flex: 0 0 auto;
    border: 1px solid #ddd;
    border-radius: 1rem;
    height: 3.5rem;
    padding: 0.8rem 1rem;
    margin-left: 1rem;
    display: flex;
    align-items: center;
    background-color: #fff;
  }

  .tax-toggle:hover {
    border-color: #999;
  }

  .tax-info {
    display: none;
  }

  /* scrollbar */
  #filters::-webkit-scrollbar {
    height: 5px;
  }

  #filters::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 10px;
  }

 .filter-options {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 1rem;
  padding: 0 2rem 1rem 2rem;
  width: 100%;
}

.price-filter {
  flex: 0 0 auto;
}

.price-filter form {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.price-input {
  width: 100px;
  padding: 0.5rem;
  border: 1px solid #ddd;
  border-radius: 10px;
}

.price-btn {
  padding: 0.5rem 1rem;
  border: none;
  border-radius: 10px;
  background-color: #fe424d;
  color: white;
  cursor: pointer;
}

.price-btn:hover {
  background-color: #e63946;
}
  
  @media (max-width: 768px) {

  .filter-options {
    justify-content: flex-start;
    flex-wrap: wrap;
    padding: 0 1rem 1rem;
  }

  .price-input {
    width: 90px;
  }

}
 </style>

<div id="filters">

    <a href="/listings?category=Trending" class="filter">
